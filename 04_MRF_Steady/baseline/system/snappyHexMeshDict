FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
castellatedMesh true;
snap true;
addLayers false;

geometry
{
    propeller.stl
    {
        type triSurfaceMesh;
        name propeller;
    }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 1000000;
    minRefinementCells 10;
    nCellsBetweenLevels 2;
    features ();
    refinementSurfaces
    {
        propeller
        {
            level (2 2);
            patchInfo
            {
                type wall;
                inGroups (propeller);
            }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions {};
    locationInMesh (0.40 0.40 0.40);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 50;
    nRelaxIter 5;
}

addLayersControls
{
    relativeSizes true;
    layers {};
    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minDeterminant 0.001;
    minTwist 0.05;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

writeFlags ();
mergeTolerance 1e-6;
