FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (1.92 0 0);
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1.92 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        tangentialVelocity  uniform (0 0 0);
        value           uniform (1.92 0 0);
    }
    walls
    {
        type            slip;
    }
    propeller
    {
        type            noSlip;
    }
}
