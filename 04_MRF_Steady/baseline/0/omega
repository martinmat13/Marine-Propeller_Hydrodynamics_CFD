FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 2.0;
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 2.0;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 2.0;
        value           uniform 2.0;
    }
    walls
    {
        type            slip;
    }
    propeller
    {
        type            omegaWallFunction;
        value           uniform 2.0;
    }
}
